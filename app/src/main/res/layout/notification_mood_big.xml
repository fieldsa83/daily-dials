<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="How\'s your mood today?" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <TextView android:id="@+id/scale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="0 awful · 5 great" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal">
        <TextView android:id="@+id/m0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/mood_0" android:gravity="center" android:text="0" android:textColor="@color/mood_ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/m1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/mood_1" android:gravity="center" android:text="1" android:textColor="@color/mood_ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/m2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/mood_2" android:gravity="center" android:text="2" android:textColor="@color/mood_ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/m3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/mood_3" android:gravity="center" android:text="3" android:textColor="@color/mood_ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/m4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/mood_4" android:gravity="center" android:text="4" android:textColor="@color/mood_ink" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/m5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/mood_5" android:gravity="center" android:text="5" android:textColor="@color/mood_ink" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
